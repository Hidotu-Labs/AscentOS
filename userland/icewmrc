# IceWM Configuration File

# Window Decoration
DecorClient=thin
TitleBarHeight=18
BorderSizeX=2
BorderSizeY=2

# Taskbar
TaskBarAtBottom=1
TaskBarVerticalTabs=0
TaskBarShowWindowIcons=1
TaskBarShowStartMenu=1
ShowTaskBar=1

# Focus and Window Management
ClickToFocus=1
FocusOnAppRaise=1
RaiseOnFocus=1
AutoRaise=0
DelayRaiseTime=500

# Workspace
WorkspaceCount=4

# Colors and Appearance
ColorNormalBorder=#404040
ColorActiveBorder=#000000
ColorNormalTitleBar=#404040
ColorActiveTitleBar=#2c5aa0
ColorNormalText=#ffffff
ColorActiveText=#ffffff

# Keyboard Shortcuts
KeySysMenu=alt+F1
KeyWinClose=alt+F4
KeyWinMaximize=alt+F10
